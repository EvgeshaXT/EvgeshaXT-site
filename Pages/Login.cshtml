@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model EvgeshaXT.Pages.LoginModel
@{
    ViewData["Title"] = @Localizer["LoginPageTitle"];
}
@section MetaTags {
    <meta name="description" content="@Localizer["LoginPageDescription"]" />
    <meta name="keywords" content="@Localizer["LoginPageKeywords"]" />
}

<div class="login">
    <form method="post">
        <fieldset>
            <legend>@Localizer["LoginPageSignIn"]</legend>
            <input type="text" name="login" placeholder="@Localizer["LoginPageLoginPlaceholder"]" maxlength="24" required />
            <input type="password" name="password" placeholder="@Localizer["LoginPagePasswordPlaceholder"]" maxlength="128" required />
            <div class="bottom">
                <div class="to-registration">
                    <label>@Localizer["LoginPageNoAccountYet"]</label> 
                    <a href="/register" translate="yes">@Localizer["LoginPageCreateAccount"]</a>
                </div>
                <button type="submit">@Localizer["LoginPageSignIn"]</button>
            </div>
        </fieldset>
    </form>
</div>