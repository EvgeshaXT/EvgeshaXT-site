@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    string currentPath = Context.Request.Path.Value ?? "";
    bool isRuPath = currentPath.StartsWith("/ru", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@(isRuPath ? "ru" : "en")">
    <head>
        <meta charset="utf-8" />
        <meta name="application name" content="EvgeshaXT's Den" />
        <meta name="author" content="EvgeshaXT" />
        <meta name="viewport" content="width=device-width" />

        <title>@ViewData["Title"]</title>

        <link rel="alternate" hreflang="x-default" href="https://evgeshaxt.com" />
        <link rel="alternate" hreflang="en" href="https://evgeshaxt.com" />
        <link rel="alternate" hreflang="ru" href="https://evgeshaxt.com/ru/" />

        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        @RenderSection("MetaTags", false)
    </head>
    <body>
        <header>
            <div class="header-left">
                <ul class="nav">
                    <li><a href="/" id="EvgeshaXT" translate="no" title="@Localizer["MenuEvgeshaxtTitle"]">EvgeshaXT</a></li>
                    <li><a href="/videos" translate="yes" title="@Localizer["MenuVideosTitle"]">@Localizer["MenuVideos"]</a></li>
                </ul>
            </div>
            <div class="header-right">
                <form method="get">
                    <select name="culture" onchange="this.form.submit()">
                        <option value="en" @(!isRuPath ? "selected" : "")>English</option>
                        <option value="ru" @(isRuPath ? "selected" : "")>Русский</option>
                    </select>
                </form>
                <a href="/login" translate="yes" title="@Localizer["MenuLoginTitle"]">@Localizer["MenuLogin"]</a>
            </div>
        </header>
        <main>
            @RenderBody()
        </main>
    </body>
</html>