@page
@model EvgeshaXT.Pages.VideosModel
@{
    ViewData["Title"] = "Videos - EvgeshaXT's Den";
}
@section MetaTags {
    <meta name="description" content="Videos and instant replays from EvgeshaXT" />
    <meta name="keywords" content="EvgeshaXT, Videos, Instant Replays" />
}

<div class="content">
    <section>
        <h1>Videos and instant replays</h1>

        <h2>Recently added:</h2>
        <div class="cards-section">
            @foreach (var video in Model.VideoCards)
            {
                <div class="video-card">
                    <video controls src="@video.Src"></video>
                    <h3>@video.Title</h3>
                    <div class="video-info">
                        <p>@video.DirectoryName</p>
                        <p>@video.DateTime.ToString("yyyy.MM.dd HH:mm")</p>
                    </div>
                </div>
            }
        </div>
        
        <hr />

        <h2>Categories:</h2>
        <div class="cards-section">
            @foreach (var directory in Model.DirectoryCards)
            {
                <div class="directory-card">
                    <a href="/videos/@directory.Name">
                        <img src="@directory.ImageUrl" alt="@directory.Name" />
                        <h3>@directory.Name</h3>
                    </a>
                </div>
            }
        </div>
    </section>
</div>