@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model EvgeshaXT.Pages.IndexModel
@{
    ViewData["Title"] = Localizer["IndexPageTitle"];
}
@section MetaTags {
    <meta name="description" content="@Localizer["IndexPageDescription"]" />
    <meta name="keywords" content="@Localizer["IndexPageKeywords"]" />
}

<div class="content">
    <section>
        <h1>@Model.DayPartMessage</h1>
        <p class="myDear">@Localizer["IndexPageMyDearGuest"]</p>
    </section>

    <div class="content-item">
        <p>@Localizer["IndexPageWelcomeText"]</p>
    </div>

    <div class="content-item">
        <div>
            <a id="osu" href="https://osu.ppy.sh/users/38564118" target="_blank">@Localizer["IndexPageMyOsuProfile"]</a>
        </div>
        <img class="mainImg" src="~/background.jpg" alt="EvgeshaXT girl on the banner" />
    </div>
</div>