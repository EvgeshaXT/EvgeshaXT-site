@page
@model EvgeshaXT.Pages.Videos.EuroTruckSimulator2Model
@{
    ViewData["Title"] = "Euro Truck Simulator 2 - EvgeshaXT's Den";
}
@section MetaTags {
    <meta name="description" content="Euro Truck Simulator 2 instant replays from EvgeshaXT" />
    <meta name="keywords" content="EvgeshaXT, Euro Truck Simulator 2, Videos, Instant Replays" />
}

<div class="content">
    <h1>Euro Truck Simulator 2 instant replays</h1>
    <div class="cards-section">
        @foreach (var video in Model.VideoCards)
        {
            <div class="video-card">
                <video controls src="@video.Src"></video>
                <h3>@video.Title</h3>
                <div class="video-info">
                    <p>@video.DirectoryName</p>
                    <p>@video.DateTime.ToString("yyyy.MM.dd HH:mm")</p>
                </div>
            </div>
        }
    </div>
</div>