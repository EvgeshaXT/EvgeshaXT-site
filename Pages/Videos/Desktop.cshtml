@page
@model EvgeshaXT.Pages.Videos.DesktopModel
@{
    ViewData["Title"] = "Desktop - EvgeshaXT's Den";
}
@section MetaTags {
    <meta name="description" content="Desktop recordings and instant replays from EvgeshaXT" />
    <meta name="keywords" content="EvgeshaXT, Desktop, Videos, Instant Replays" />
}

<div class="content">
    <h1>Desktop recordings and instant replays</h1>
    <div class="cards-section">
        @foreach (var video in Model.VideoCards)
        {
            <div class="video-card">
                <video controls src="@video.Src"></video>
                <h3>@video.Title</h3>
                <div class="video-info">
                    <p>@video.DirectoryName</p>
                    <p>@video.DateTime.ToString("yyyy.MM.dd HH:mm")</p>
                </div>
            </div>
        }
    </div>
</div>