@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model EvgeshaXT.Pages.Ru.Videos.MusicModel
@{
    ViewData["Title"] = @Localizer["VideosMusicPageTitle"];
}
@section MetaTags {
    <meta name="description" content="@Localizer["VideosMusicPageDescription"]" />
    <meta name="keywords" content="@Localizer["VideosMusicPageKeywords"]" />
}

<div class="content">
    <h1>@Localizer["VideosMusicPageH1"]</h1>
    <div class="cards-section">
        @foreach (var video in Model.VideoCards)
        {
            <div class="video-card">
                <video controls src="@video.Src"></video>
                <h3>@video.Title</h3>
                <div class="video-info">
                    <p>@video.DirectoryName</p>
                    <p>@video.DateTime.ToString("yyyy.MM.dd HH:mm")</p>
                </div>
            </div>
        }
    </div>
</div>