@page

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@model EvgeshaXT.Pages.Ru.VideosModel
@{
    ViewData["Title"] = @Localizer["VideosPageTitle"];
}
@section MetaTags {
    <meta name="description" content="@Localizer["VideosPageDescription"]" />
    <meta name="keywords" content="@Localizer["VideosPageKeywords"]" />
}

<div class="content">
    <section>
        <h1>@Localizer["VideosPageH1"]</h1>

        <h2>@Localizer["VideosPageLastAdded"]</h2>
        <div class="cards-section">
            @foreach (var video in Model.VideoCards)
            {
                <div class="video-card">
                    <video controls src="@video.Src"></video>
                    <h3>@video.Title</h3>
                    <div class="video-info">
                        <p>@video.DirectoryName</p>
                        <p>@video.DateTime.ToString("yyyy.MM.dd HH:mm")</p>
                    </div>
                </div>
            }
        </div>
        
        <hr />

        <h2>@Localizer["VideosPageCategories"]</h2>
        <div class="cards-section">
            @foreach (var directory in Model.DirectoryCards)
            {
                <div class="directory-card">
                    <a href="/videos/@directory.Name">
                        <img src="@directory.ImageUrl" alt="@directory.Name" />
                        <h3>@directory.Name</h3>
                    </a>
                </div>
            }
        </div>
    </section>
</div>